{
  "version": "1.0.0",
  "project": "brokerflow-ai",
  "folder": "schemas/partners",
  "description": "Action-ready OpenAPI schemas for partner, affiliate, channel partner, and referral partner workflows.",
  "base_urls": {
    "no_auth_webhooks": "https://YOUR-AUTOMATION-DOMAIN.com",
    "api_key_backend": "https://brokerflow-ai.vercel.app/api"
  },
  "schemas": [
    {
      "id": "partner-signup",
      "file": "openapi-no-auth-partner-signup.yaml",
      "auth": "none",
      "endpoints": ["POST /webhook/partner-signup"],
      "status": "built"
    },
    {
      "id": "partner-referral-lead-intake",
      "file": "openapi-no-auth-referral-lead-intake.yaml",
      "auth": "none",
      "endpoints": ["POST /webhook/partner-referral-lead"],
      "status": "built"
    },
    {
      "id": "channel-partner-prospect",
      "file": "openapi-no-auth-channel-partner-prospect.yaml",
      "auth": "none",
      "endpoints": ["POST /webhook/channel-partner-prospect"],
      "status": "built"
    },
    {
      "id": "warm-intro-request",
      "file": "openapi-no-auth-warm-intro-request.yaml",
      "auth": "none",
      "endpoints": ["POST /webhook/warm-intro-request"],
      "status": "built"
    },
    {
      "id": "partner-followup-trigger",
      "file": "openapi-no-auth-partner-followup-trigger.yaml",
      "auth": "none",
      "endpoints": ["POST /webhook/partner-followup"],
      "status": "built"
    },
    {
      "id": "partner-crm-sync",
      "file": "openapi-api-key-partner-crm-sync.yaml",
      "auth": "api_key_bearer",
      "endpoints": [
        "POST /partners/upsert",
        "GET /partners/{partner_id}",
        "PATCH /partners/{partner_id}/stage",
        "POST /partners/{partner_id}/notes"
      ],
      "status": "built"
    },
    {
      "id": "partner-attribution",
      "file": "openapi-api-key-partner-attribution.yaml",
      "auth": "api_key_bearer",
      "endpoints": [
        "POST /partner-attribution/events",
        "GET /partners/{partner_id}/attribution",
        "GET /leads/{lead_id}/attribution"
      ],
      "status": "built"
    },
    {
      "id": "partner-onboarding",
      "file": "openapi-api-key-partner-onboarding.yaml",
      "auth": "api_key_bearer",
      "endpoints": [
        "POST /partners/{partner_id}/onboarding-checklist",
        "PATCH /partners/{partner_id}/onboarding-step",
        "GET /partners/{partner_id}/onboarding-status"
      ],
      "status": "built"
    }
  ],
  "planned_next": [
    "openapi-api-key-partner-performance.yaml",
    "openapi-api-key-partner-payout-readiness.yaml",
    "openapi-api-key-co-marketing-assets.yaml",
    "openapi-api-key-partner-portal-provisioning.yaml",
    "openapi-oauth-partner-calendar-scheduling.yaml",
    "openapi-oauth-partner-drive-folder.yaml"
  ],
  "guardrails": [
    "No action approves, declines, qualifies, guarantees, underwrites, funds, or pays automatically.",
    "No-auth endpoints must include shared_secret and event_id.",
    "Funding-adjacent, partner-activation, and payout-adjacent work requires human review.",
    "Do not transmit raw documents or sensitive borrower data through partner-facing schemas."
  ]
}
