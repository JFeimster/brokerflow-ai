{
  "name": "brokerflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BrokerFlow broker operations platform with deal intake, review queues, partner workflows, automation activity, and ChatGPT integration.",
  "keywords": [
    "brokerflow",
    "loan-broker",
    "custom-gpt",
    "automation",
    "business-funding",
    "moonshine-capital",
    "distilled-funding"
  ],
  "author": "Moonshine Capital / Distilled Funding",
  "license": "UNLICENSED",
  "homepage": "https://brokerflow-ai.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/JFeimster/brokerflow-ai.git"
  },
  "bugs": {
    "url": "https://github.com/JFeimster/brokerflow-ai/issues"
  },
  "type": "module",
  "main": "script.js",
  "scripts": {
    "dev": "serve .",
    "start": "serve .",
    "build": "node scripts/check-js.js && node -e \"JSON.parse(require('fs').readFileSync('vercel.json', 'utf8')); JSON.parse(require('fs').readFileSync('plugin/plugin.json', 'utf8'))\"",
    "preview": "serve .",
    "package:plugin": "node scripts/package-private-plugin.js",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "lint": "node scripts/check-js.js",
    "test": "node scripts/run-tests.js",
    "test:postgres": "node scripts/run-tests.js --postgres"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "prettier": "^3.3.3",
    "serve": "^14.2.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "^2.118.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
